# Copy to .env. Never commit credentials. Run scripts/start.ps1 to load it.
APP_ENV=development
DEMO_MODE=true
# Optional: DATABASE_URL defaults to the absolute project data/continuum.db path.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/continuum
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
# Required for a new non-demo installation (at least 12 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
